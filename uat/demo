#!/usr/bin/env python3
"""Record the demo: a morning in the app, as a video and a GIF.

    uat/demo [--theme NAME] [--out DIR]

The app runs in a tmux session on scratch data, the way uat/tui runs it,
seeded with a day that has already passed so the recording opens on the
morning review. Every keystroke is one frame, captured with tmux and drawn
with render.py in the theme's colours, cropped to the terminal with no
wallpaper or window border. ffmpeg turns the frames into demo.mp4 and
demo.gif under --out, assets/ by default. Frames and working files stay
under .scratch/demo/.

The theme is tokyo-night unless --theme says otherwise; a theme needs a
colors.toml or foot.ini under /usr/share/omarchy/themes.
"""
import os, shutil, subprocess, sys, time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import render  # noqa: E402

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
TUI = HERE / "tui"
WORK = ROOT / ".scratch" / "demo"
SESSION = "jobsdone-demo"
SIZE = "120x36"
COLS, ROWS = 120, 36
SCALE = 2          # device pixels per CSS pixel in the rendered frames
GIF_WIDTH = 976    # readable at the README's display width


# --- The storyboard -------------------------------------------------------
# Each step is what a person does, and how long the screen then stays
# still. "type" holds after every character, "keys" after the last key.

STORY = [
    ("hold", None, 3.0),                   # yesterday's unfinished work
    ("keys", ["t"], 1.5),                  # carry the report into today
    ("keys", ["b"], 1.5),                  # passport can wait in the backlog
    ("keys", ["Enter"], 3.0),              # today's due task and reminder
    ("keys", ["t"], 1.5),                  # call the accountant today
    ("keys", ["t"], 1.5),                  # make the dentist appointment
    ("keys", ["Enter"], 2.5),              # a manageable plan for today
    ("keys", ["a"], 0.7),
    ("type", "Send report to the team", 0.065),
    ("keys", ["Enter"], 0.7),
    ("keys", ["Escape"], 1.2),
    ("keys", ["k", "k", "k"], 0.8),        # back to the report
    ("keys", ["f"], 2.5),                  # choose the day's main priority
    ("keys", ["j", "j"], 1.0),             # book the dentist: a quick win
    ("keys", ["Space"], 4.0),              # finish with focus, plan and done
]


# --- Driving --------------------------------------------------------------

def sh(*args, **kw):
    try:
        return subprocess.run(args, check=True, text=True, capture_output=True, **kw).stdout
    except subprocess.CalledProcessError as error:
        print(error.stderr, file=sys.stderr)
        raise


def tui(*args):
    return sh(str(TUI), *args, env=dict(os.environ, UAT_SESSION=SESSION))


def tmux(*args):
    return sh("tmux", *args)


def send_keys(*keys):
    tmux("send-keys", "-t", f"{SESSION}:", "--", *keys)


def send_text(text):
    tmux("send-keys", "-t", f"{SESSION}:", "-l", "--", text)


def seed():
    """A backlog and a day that has passed, written the way a person would
    have written them, then moved back a day with SQL."""
    tui("start", "--fresh", "--size", SIZE)
    add("Write the weekly report", "Renew the passport")
    send_keys("l")
    add("Call the accountant about Q3", "Book the dentist",
        "Plan the autumn holiday", "Quote from the electrician")
    tui("stop")
    tui("sql", "update tasks set day = date('now', '-1 day') where day is not null")
    tui("sql", "update placements set day = date('now', '-1 day')")
    tui("sql", "update tasks set due_on = date('now') where title like 'Call the accountant%'")
    tui("sql", "update tasks set remind_on = date('now') where title like 'Book the dentist%'")
    tui("sql", "update tasks set waiting = 1 where title like 'Quote from%'")
    tui("sql", "delete from meta")


def add(*titles):
    """Type the titles into the pane the cursor is in. The field stays open
    after Enter, and Escape is sent on its own: right before another key
    it would read as Alt."""
    send_keys("a")
    for title in titles:
        send_text(title)
        send_keys("Enter")
        time.sleep(0.2)
    send_keys("Escape")
    time.sleep(0.3)


class Recorder:
    def __init__(self):
        self.frames = []       # (ansi text, seconds)

    def capture(self, hold):
        time.sleep(0.12)
        ansi = tmux("capture-pane", "-t", f"{SESSION}:", "-p", "-e")
        (WORK / f"capture-{len(self.frames):03d}.ansi").write_text(ansi)
        self.frames.append((ansi, hold))

    def run(self):
        tui("start", "--size", SIZE)
        time.sleep(0.8)
        for step in STORY:
            kind, what, hold = step
            if kind == "hold":
                self.capture(hold)
            elif kind == "keys":
                for key in what:
                    send_keys(key)
                    time.sleep(0.05)
                self.capture(hold)
            elif kind == "type":
                for ch in what:
                    send_text(ch)
                    self.capture(hold)
        tui("stop")


# --- Drawing --------------------------------------------------------------

def draw(frames, theme):
    """Every distinct screen once, as a PNG; returns the file per frame."""
    slots, fg, bg = render.palette(theme)
    frame_dir = WORK / "frames"
    shutil.rmtree(frame_dir, ignore_errors=True)
    frame_dir.mkdir(parents=True)
    # Measure the terminal itself; every edge uses the theme background.
    distinct, files = {}, []
    for ansi, _ in frames:
        if ansi not in distinct:
            distinct[ansi] = frame_dir / f"{len(distinct):04d}.html"
        files.append(distinct[ansi])
    probe = frame_dir / "probe.html"
    probe.write_text(render.render(frames[0][0], COLS, ROWS, slots, fg, bg))
    w, h = (int(v) for v in node(f"""
        const p = await b.newPage({{deviceScaleFactor: {SCALE}}});
        await p.goto('file://{probe}');
        const r = await (await p.$('pre')).boundingBox();
        console.log(Math.ceil(r.width) * {SCALE}, Math.ceil(r.height) * {SCALE});
    """).split())
    for ansi, path in distinct.items():
        path.write_text(render.render(ansi, COLS, ROWS, slots, fg, bg))
    node(f"""
        const p = await b.newPage({{deviceScaleFactor: {SCALE}, viewport: {{width: {w // SCALE}, height: {h // SCALE}}}}});
        for (const f of {[str(p) for p in distinct.values()]!r}) {{
            await p.goto('file://' + f);
            await p.screenshot({{path: f.replace(/\\.html$/, '.png')}});
        }}
    """)
    return [f.with_suffix(".png") for f in files], w, h


def node(body):
    script = f"""
const {{ chromium }} = require('playwright');
(async () => {{
  const b = await chromium.launch({{
    executablePath: process.env.DEMO_CHROMIUM || undefined,
  }});
  {body}
  await b.close();
}})();
"""
    env = dict(os.environ, NODE_PATH=os.environ.get("NODE_PATH", str(render.PLAYWRIGHT)))
    return sh("node", "-e", script, env=env)


# --- Encoding -------------------------------------------------------------

def encode(frames, files, out_dir):
    listing = WORK / "frames.txt"
    lines = []
    for (_, hold), path in zip(frames, files):
        lines += [f"file '{path}'", f"duration {hold:.3f}"]
    lines += [f"file '{files[-1]}'", "duration 0.04"]   # a duration only counts with a file after it
    listing.write_text("\n".join(lines) + "\n")
    out_dir.mkdir(parents=True, exist_ok=True)
    mp4, gif = out_dir / "demo.mp4", out_dir / "demo.gif"
    total = sum(hold for _, hold in frames)
    sh("ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", str(listing),
       "-vf", "fps=30,format=yuv420p", "-c:v", "libx264", "-crf", "20", "-preset", "slow",
       "-movflags", "+faststart", "-t", f"{total:.3f}", str(mp4))
    sh("ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", str(listing),
       "-vf", f"scale={GIF_WIDTH}:-1:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=sierra2_4a",
       "-fps_mode", "passthrough", "-loop", "0", str(gif))
    return mp4, gif


def main():
    args = sys.argv[1:]
    theme, out_dir = "tokyo-night", ROOT / "assets"
    while args:
        if args[0] == "--theme":
            theme = args[1]; args = args[2:]
        elif args[0] == "--out":
            out_dir = Path(args[1]).resolve(); args = args[2:]
        else:
            sys.exit(__doc__)
    WORK.mkdir(parents=True, exist_ok=True)
    subprocess.run(["tmux", "kill-session", "-t", f"={SESSION}"], capture_output=True)
    seed()
    print("seeded a day that has passed")
    rec = Recorder()
    rec.run()
    total = sum(h for _, h in rec.frames)
    print(f"recorded {len(rec.frames)} frames, {total:.1f}s")
    files, w, h = draw(rec.frames, theme)
    print(f"drew {len(set(files))} distinct screens at {w}x{h} in {theme}")
    mp4, gif = encode(rec.frames, files, out_dir)
    for f in (mp4, gif):
        print(f"{f.relative_to(ROOT) if f.is_relative_to(ROOT) else f}: {f.stat().st_size // 1024} KiB")


if __name__ == "__main__":
    main()

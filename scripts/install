#!/usr/bin/env bash
# Install jobsdone for the current user: the binary, a launcher entry, and
# on Omarchy the keybind and the window the app asks Hyprland for.
#
#   scripts/install [--binary PATH] [--keybind [KEYS] | --no-keybind]
#                   [--notes-keybind [KEYS] | --no-notes-keybind]
#                   [--floating | --tiled] [--size WxH]
#
# --keybind binds KEYS, or SUPER + SHIFT + J when none are given, to open
# the app; --notes-keybind binds KEYS, or SUPER + SHIFT + N, to open it on
# the notes page. --no-keybind and --no-notes-keybind bind nothing. With
# neither, a keybind is offered at the prompt when a terminal is attached
# and skipped otherwise. Keys that something else is bound to are taken
# over only on a yes at the prompt, never unasked.
# --binary copies an executable built elsewhere instead of running Cargo.
# --floating, --tiled and --size are the window the app opens in: they are
# settings, and the app writes the Hyprland rule for them itself. A window
# flag left off keeps the setting as it is. Running the script again
# updates everything in place; scripts/uninstall takes it all out again
# and leaves the data.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

APP_ID="org.omarchy.jobsdone"       # Omarchy's app-id convention for TUIs
BIND_NAME="Jobsdone"                # what the keybinds call themselves in Hyprland
NOTES_BIND_NAME="Jobsdone notes"
BINARY="$HOME/.local/bin/jobsdone"
LAUNCHER="$HOME/.local/bin/jobsdone-terminal"
DESKTOP_FILE="$DATA_HOME/applications/jobsdone.desktop"
ICON_FILE="$DATA_HOME/icons/hicolor/scalable/apps/jobsdone.svg"
BINDINGS="$CONFIG_HOME/hypr/bindings.lua"
OMARCHY_BINDINGS="${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr/bindings"
FOOT_CONFIG="$CONFIG_HOME/jobsdone/foot.ini"
KITTY_CONFIG="$CONFIG_HOME/jobsdone/kitty.conf"
ALACRITTY_CONFIG="$CONFIG_HOME/jobsdone/alacritty.toml"
ALACRITTY_013_CONFIG="$CONFIG_HOME/jobsdone/alacritty-0.13.toml"
GHOSTTY_CONFIG="$CONFIG_HOME/jobsdone/ghostty.conf"

# The keybinds are the script's, a block each; the window rule is the
# program's, in a block of its own that `jobsdone desktop` writes. Some
# machines have a single block holding a keybind and the window rule,
# which is taken out when it is found.
KEYBIND_BEGIN="-- jobsdone: keybind (begin)"
KEYBIND_END="-- jobsdone: keybind (end)"
NOTES_KEYBIND_BEGIN="-- jobsdone: notes keybind (begin)"
NOTES_KEYBIND_END="-- jobsdone: notes keybind (end)"
BOTH_BEGIN="-- jobsdone: begin"
BOTH_END="-- jobsdone: end"

say() { printf '%s\n' "$*"; }
die() { printf 'install: %s\n' "$*" >&2; exit 1; }
atomic_install() (
    mkdir -p "$(dirname "$2")"
    staged_file="$(mktemp "$2.XXXXXX")"
    trap 'rm -f "$staged_file"' EXIT
    install -m755 "$1" "$staged_file"
    mv -f "$staged_file" "$2"
)
quoted_string() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
# The header above, which is the usage message.
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; }

on_omarchy() { [ -d "${OMARCHY_PATH:-/usr/share/omarchy}" ] && command -v omarchy-launch-tui >/dev/null; }
hyprland_running() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; }

# --- the command line --------------------------------------------------------

KEYBIND="SUPER + SHIFT + J"
keys_given=no
keybind_choice=""        # yes, no, or empty for "ask"
NOTES_KEYBIND="SUPER + SHIFT + N"
notes_keys_given=no
notes_keybind_choice=""
window=()                # the flags `jobsdone desktop` is given
source_binary=""

while [ $# -gt 0 ]; do
    case "$1" in
        --binary)
            case "${2:-}" in
                "" | -*) usage >&2; exit 2 ;;
                *) source_binary="$2"; shift ;;
            esac
            ;;
        --keybind)
            keybind_choice=yes
            case "${2:-}" in
                "" | -*) ;;
                *) KEYBIND="$2"; keys_given=yes; shift ;;
            esac
            ;;
        --no-keybind) keybind_choice=no ;;
        --notes-keybind)
            notes_keybind_choice=yes
            case "${2:-}" in
                "" | -*) ;;
                *) NOTES_KEYBIND="$2"; notes_keys_given=yes; shift ;;
            esac
            ;;
        --no-notes-keybind) notes_keybind_choice=no ;;
        --floating | --tiled) window+=("$1") ;;
        --size)
            case "${2:-}" in
                [0-9]*x[0-9]*) window+=(--size "$2"); shift ;;
                *) usage >&2; exit 2 ;;
            esac
            ;;
        -h | --help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

# --- the binary --------------------------------------------------------------

# ~/.local/bin rather than cargo's own ~/.cargo/bin: the desktop session
# that runs the keybind and the launcher entry has the former on its PATH
# and, on a machine where Rust was installed for this alone, not the latter.
if [ -n "$source_binary" ]; then
    [ -x "$source_binary" ] || die "--binary must name an executable file"
    if ! [ -e "$BINARY" ] || ! [ "$source_binary" -ef "$BINARY" ]; then
        atomic_install "$source_binary" "$BINARY"
    fi
else
    command -v cargo >/dev/null || die "cargo was not found. Install Rust first: on Arch 'sudo pacman -S rustup && rustup default stable', elsewhere https://rustup.rs"
    say "building and installing the binary with cargo..."
    (cd "$ROOT" && cargo install --locked --path . --root "$HOME/.local" --quiet --force)
fi
atomic_install "$ROOT/scripts/launch-terminal" "$LAUNCHER"
atomic_install "$ROOT/scripts/uninstall" "$HOME/.local/bin/jobsdone-uninstall"
if [ -n "$source_binary" ]; then
    atomic_install "$ROOT/scripts/install-release" "$HOME/.local/bin/jobsdone-update"
else
    rm -f "$HOME/.local/bin/jobsdone-update"
fi
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *)
        say '~/.local/bin is not on your PATH in this shell.'
        say 'Run now: "$HOME/.local/bin/jobsdone"'
        say 'For Bash or Zsh, run: export PATH="$HOME/.local/bin:$PATH"'
        say 'Add that line to ~/.bashrc (Bash) or ~/.zshrc (Zsh) to keep it for new shells.' ;;
esac

launcher_ready=no
if "$LAUNCHER" --check; then
    launcher_ready=yes
else
    say 'The desktop launcher needs a terminal that could not be found.'
    say 'Install Kitty, Alacritty or Ghostty, or Foot on Wayland, and check your TERMINAL / JOBSDONE_TERMINAL setting if set.'
    say 'You can still run Jobsdone in your current terminal: "$HOME/.local/bin/jobsdone"'
fi

# --- the launcher entry ------------------------------------------------------

mkdir -p "$(dirname "$ICON_FILE")" "$(dirname "$DESKTOP_FILE")" "$(dirname "$FOOT_CONFIG")"
cp "$ROOT/assets/jobsdone.svg" "$ICON_FILE"

{
    if [ -f "$CONFIG_HOME/foot/foot.ini" ]; then
        printf 'include=%s\n' "$CONFIG_HOME/foot/foot.ini"
    fi
    cat <<'EOF'
[key-bindings]
clipboard-copy=none
prompt-next=none
clipboard-paste=Shift+Insert Control+Shift+v

[text-bindings]
\x1b[99;6u=Control+Insert Control+Shift+c
\x1b[120;6u=Control+x Control+Shift+x
EOF
} > "$FOOT_CONFIG"

{
    if [ -f "$CONFIG_HOME/kitty/kitty.conf" ]; then
        printf 'include %s\n' "$CONFIG_HOME/kitty/kitty.conf"
    fi
    cat <<'EOF'
map ctrl+insert send_text all \x1b[99;6u
map ctrl+shift+c send_text all \x1b[99;6u
map ctrl+x send_text all \x1b[120;6u
map ctrl+shift+x send_text all \x1b[120;6u
map shift+insert paste_from_clipboard
map ctrl+shift+v paste_from_clipboard
EOF
} > "$KITTY_CONFIG"

{
    if [ -f "$CONFIG_HOME/alacritty/alacritty.toml" ]; then
        alacritty_import="$(quoted_string "$CONFIG_HOME/alacritty/alacritty.toml")"
        printf 'general.import = [ "%s" ]\n' "$alacritty_import"
    fi
    cat <<'EOF'
[keyboard]
bindings = [
{ key = "Insert", mods = "Control", chars = "\u001B[99;6u" },
{ key = "C", mods = "Control|Shift", chars = "\u001B[99;6u" },
{ key = "X", mods = "Control", chars = "\u001B[120;6u" },
{ key = "X", mods = "Control|Shift", chars = "\u001B[120;6u" },
{ key = "Insert", mods = "Shift", action = "Paste" },
{ key = "V", mods = "Control|Shift", action = "Paste" }
]
EOF
} > "$ALACRITTY_CONFIG"

sed 's/^general\.import = /import = /' "$ALACRITTY_CONFIG" > "$ALACRITTY_013_CONFIG"

# Ghostty loads its default config before the CLI --config-file profile.
# Including it again here can load nested theme files twice and trigger a cycle.
cat > "$GHOSTTY_CONFIG" <<'EOF'
keybind = ctrl+insert=text:\x1b[99;6u
keybind = ctrl+shift+c=text:\x1b[99;6u
keybind = ctrl+x=text:\x1b[120;6u
keybind = ctrl+shift+x=text:\x1b[120;6u
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
EOF

exec_line="$LAUNCHER"
exec_line="$(quoted_string "$exec_line")"
exec_line="${exec_line//\`/\\\`}"
exec_line="${exec_line//\$/\\\$}"
exec_line="\"$exec_line\""
terminal=false
cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Jobsdone
Comment=A keyboard-first daily task manager for the terminal
Exec=$exec_line
Terminal=$terminal
Icon=jobsdone
Categories=Office;Utility;
Keywords=tasks;todo;
StartupNotify=true
EOF
command -v update-desktop-database >/dev/null && update-desktop-database "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q "$DATA_HOME/icons/hicolor" 2>/dev/null || true

# --- Omarchy: the keybinds and the window -----------------------------------

if ! on_omarchy; then
    if [ "$launcher_ready" = yes ]; then
        say 'Open Jobsdone from your app launcher.'
    fi
    exit 0
fi

# Hyprland reports a bind as a modmask and a key, so keys written for a
# person are read into the same two things to ask what they are bound to.
modmask_of() {
    local mask=0 part
    for part in ${1//+/ }; do
        case "${part^^}" in
            SHIFT) mask=$((mask | 1)) ;;
            CAPS | CAPSLOCK) mask=$((mask | 2)) ;;
            CTRL | CONTROL) mask=$((mask | 4)) ;;
            ALT) mask=$((mask | 8)) ;;
            SUPER | MOD | WIN | LOGO) mask=$((mask | 64)) ;;
        esac
    done
    printf '%s' "$mask"
}

# The key the modifiers are held down for, which is the last one written.
key_of() {
    local part key=""
    for part in ${1//+/ }; do
        case "${part^^}" in
            SHIFT | CAPS | CAPSLOCK | CTRL | CONTROL | ALT | SUPER | MOD | WIN | LOGO) ;;
            *) key="$part" ;;
        esac
    done
    printf '%s' "${key,,}"
}

same_keys() { [ "$(modmask_of "$1")+$(key_of "$1")" = "$(modmask_of "$2")+$(key_of "$2")" ]; }

# What the keys are bound to now, or nothing. Hyprland answers exactly
# while it is running; otherwise the person's bindings file and the
# bindings Omarchy ships are the best witnesses there are. The bind named
# in the second argument is not an answer: it is the one about to be
# written again.
keybind_taken_by() {
    local keys="$1" own="$2" taken=""
    if hyprland_running; then
        taken="$( (hyprctl binds -j 2>/dev/null || true) | python3 -c '
import json, sys
mask, key = int(sys.argv[1]), sys.argv[2]
for bind in json.load(sys.stdin):
    if bind["modmask"] == mask and bind["key"].lower() == key:
        print(bind["description"] or bind["dispatcher"] + " " + bind["arg"])
        break
' "$(modmask_of "$keys")" "$(key_of "$keys")" || true)"
    else
        local pattern file witnesses=()
        pattern="$(printf '%s' "$keys" | sed -E 's/[[:space:]]*\+[[:space:]]*/[[:space:]]*\\+[[:space:]]*/g')"
        [ -f "$BINDINGS" ] && witnesses+=("$BINDINGS")
        for file in "$OMARCHY_BINDINGS"/*.lua; do
            [ -f "$file" ] && witnesses+=("$file")
        done
        if [ ${#witnesses[@]} -gt 0 ]; then
            taken="$(cat "${witnesses[@]}" | grep -v '^[[:space:]]*--' |
                grep -ioE "o\.bind(_toggle)?\(\"$pattern\",[[:space:]]*\"[^\"]*\"" |
                head -1 | sed -E 's/.*,[[:space:]]*"([^"]*)"/\1/' || true)"
        fi
    fi
    [ "$taken" = "$own" ] || printf '%s' "$taken"
}

# The keys a block of ours binds, if it is there and binds any.
block_keys() {
    [ -f "$BINDINGS" ] || return 0
    awk -v begin="$1" -v end="$2" '
        index($0, begin) == 1 { inside = 1; next }
        index($0, end) == 1 { inside = 0 }
        inside
    ' "$BINDINGS" | grep -oE 'o\.bind\("[^"]*"' | head -1 | sed -E 's/o\.bind\("([^"]*)"/\1/' || true
}

# A block of ours as it stands in the file, markers included.
block_text() {
    awk -v begin="$1" -v end="$2" '
        index($0, begin) == 1 { inside = 1 }
        inside
        index($0, end) == 1 { inside = 0 }
    ' "$BINDINGS"
}

# Whether a block of ours unbinds its keys before binding them.
block_unbinds() {
    awk -v begin="$1" -v end="$2" '
        index($0, begin) == 1 { inside = 1; next }
        index($0, end) == 1 { inside = 0 }
        inside
    ' "$BINDINGS" | grep -qF 'hl.unbind('
}

remove_block() {
    local begin="$1" end="$2"
    [ -f "$BINDINGS" ] && grep -qF -- "$begin" "$BINDINGS" || return 0
    # The block, and the blank line that was under it, so that taking it
    # out and putting it back leaves the file as it was.
    awk -v begin="$begin" -v end="$end" '
        index($0, begin) == 1 { inside = 1 }
        inside { if (index($0, end) == 1) { inside = 0; blank = 1 } next }
        blank && $0 ~ /^[[:space:]]*$/ { blank = 0; next }
        { blank = 0; print }
    ' "$BINDINGS" > "$BINDINGS.jobsdone"
    printf '%s\n' "$(cat "$BINDINGS.jobsdone")" > "$BINDINGS"
    rm -f "$BINDINGS.jobsdone"
}

# The block where it already is, so that rewriting it never moves anybody
# else's lines, and at the end of the file otherwise.
write_block() {
    local begin="$1" end="$2" body="$3"
    if grep -qF -- "$begin" "$BINDINGS"; then
        # The body goes through the environment: -v would read the
        # backslashes of a quoted path as escapes and drop them.
        BODY="$body" awk -v begin="$begin" -v end="$end" '
            index($0, begin) == 1 { print ENVIRON["BODY"]; inside = 1; next }
            index($0, end) == 1 { inside = 0; next }
            !inside { print }
        ' "$BINDINGS" > "$BINDINGS.jobsdone"
        mv "$BINDINGS.jobsdone" "$BINDINGS"
    else
        printf '\n%s\n' "$body" >> "$BINDINGS"
    fi
}

# Settles one keybind: NAME as Hyprland lists it, the KEYS and whether
# they were GIVEN on the command line, the CHOICE the flags made, the
# block's BEGIN and END, the ARGUMENTS the launcher is run with, what the
# keys OPEN, and the keys an earlier block of ours INHERITED to this one.
# Leaves the keys in $settled_keys and yes or no in $settled.
settle_keybind() {
    local name="$1" keys="$2" given="$3" choice="$4" begin="$5" end="$6"
    local arguments="$7" opens="$8" inherited="${9:-}"
    local ours taken answer unbind=no want=no command

    command="o.shell_quote(\"$lua_launcher\")"
    [ -z "$arguments" ] || command="$command .. \" $arguments\""

    ours="$(block_keys "$begin" "$end")"
    [ -n "$ours" ] || ours="$inherited"
    # The keys already bound stand unless another set was asked for.
    [ "$given" = yes ] || [ -z "$ours" ] || keys="$ours"

    if [ "$choice" = no ]; then
        want=no
    elif [ -n "$reserved_keys" ] && same_keys "$reserved_keys" "$keys"; then
        say "$keys opens Jobsdone, so it cannot also open $opens; that keybind is not added"
    elif [ -n "$ours" ] && same_keys "$ours" "$keys"; then
        # Already ours. Hyprland lists only our bind once another has been
        # unbound for it, so the block is what remembers the unbind.
        want=yes
        ! block_unbinds "$begin" "$end" || unbind=yes
    else
        taken="$(keybind_taken_by "$keys" "$name")"
        if [ -n "$taken" ] && [ -t 0 ] && [ -t 1 ]; then
            printf "%s is already bound to '%s'. Overwrite '%s' to open %s? [y/N] " "$keys" "$taken" "$taken" "$opens"
            read -r answer
            case "$answer" in y* | Y*) want=yes; unbind=yes ;; esac
        elif [ -n "$taken" ]; then
            say "$keys is already bound to '$taken', and there is no terminal to ask about overwriting it on."
        elif [ -n "$choice" ]; then
            want="$choice"
        elif [ -t 0 ] && [ -t 1 ]; then
            printf '%s is free. Bind it to open %s? [Y/n] ' "$keys" "$opens"
            read -r answer
            case "$answer" in n* | N*) want=no ;; *) want=yes ;; esac
        else
            say "no terminal to ask on; the keybind for $opens is not added (pass --keybind or --notes-keybind to add it)"
        fi
        if [ -n "$taken" ] && [ "$want" = no ]; then
            if [ -n "$ours" ]; then
                say "$ours stays the keybind for $opens."
                keys="$ours"
                want=yes
                ! block_unbinds "$begin" "$end" || unbind=yes
            else
                say "No keybind is added for $opens. Bind one yourself with"
                say "    o.bind(\"<keys>\", \"$name\", $command)"
                say "in $BINDINGS."
            fi
        fi
    fi

    if [ "$want" = yes ]; then
        local body="$begin"
        [ "$unbind" = no ] || body="$body
hl.unbind(\"$keys\")"
        body="$body
o.bind(\"$keys\", \"$name\", $command)
$end"
        if [ "$(block_text "$begin" "$end")" = "$body" ]; then
            say "$keys is already bound to open $opens"
        else
            write_block "$begin" "$end" "$body"
            say "wrote the $keys keybind to $BINDINGS"
        fi
    else
        remove_block "$begin" "$end"
    fi
    settled_keys="$keys"
    settled="$want"
}

mkdir -p "$(dirname "$BINDINGS")"
touch "$BINDINGS"

inherited=""
if grep -qF -- "$BOTH_BEGIN" "$BINDINGS"; then
    inherited="$(block_keys "$BOTH_BEGIN" "$BOTH_END")"
    remove_block "$BOTH_BEGIN" "$BOTH_END"
    say "took the single block an earlier install left out of $BINDINGS"
fi

lua_launcher="$(quoted_string "$LAUNCHER")"
reserved_keys=""
settle_keybind "$BIND_NAME" "$KEYBIND" "$keys_given" "$keybind_choice" \
    "$KEYBIND_BEGIN" "$KEYBIND_END" "" "Jobsdone" "$inherited"
KEYBIND="$settled_keys"
want_keybind="$settled"

[ "$want_keybind" = no ] || reserved_keys="$KEYBIND"
settle_keybind "$NOTES_BIND_NAME" "$NOTES_KEYBIND" "$notes_keys_given" "$notes_keybind_choice" \
    "$NOTES_KEYBIND_BEGIN" "$NOTES_KEYBIND_END" "--notes" "Jobsdone on the notes page"
NOTES_KEYBIND="$settled_keys"
want_notes_keybind="$settled"

# The window rule is the program's own block, written from the settings
# these flags change, and it is what reloads Hyprland.
"$BINARY" desktop "${window[@]}"

if hyprland_running; then
    if [ "$want_keybind" = yes ] && [ "$launcher_ready" = yes ]; then
        say "press $KEYBIND to open Jobsdone"
    fi
    if [ "$want_notes_keybind" = yes ] && [ "$launcher_ready" = yes ]; then
        say "press $NOTES_KEYBIND to open Jobsdone on the notes page"
    fi
else
    say "Hyprland is not running here; what was written takes effect at the next login"
fi
exit 0

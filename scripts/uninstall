#!/usr/bin/env bash
# Remove what scripts/install put in place: the binary, the launcher entry
# and icon, and the blocks in Hyprland's bindings file. The data and the
# log stay where they are; the last line says where.
set -euo pipefail

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

DESKTOP_FILE="$DATA_HOME/applications/jobsdone.desktop"
ICON_FILE="$DATA_HOME/icons/hicolor/scalable/apps/jobsdone.svg"
BINDINGS="$CONFIG_HOME/hypr/bindings.lua"

# The keybind is the install script's block and the window rule is the
# program's own; some machines have a single block holding both.
BLOCKS=(
    "-- jobsdone: keybind (begin)"  "-- jobsdone: keybind (end)"
    "-- jobsdone: window (begin)"   "-- jobsdone: window (end)"
    "-- jobsdone: begin"            "-- jobsdone: end"
)

say() { printf '%s\n' "$*"; }

remove_block() {
    local begin="$1" end="$2"
    grep -qF -- "$begin" "$BINDINGS" || return 1
    # The block, and the blank line that was under it, so that taking it
    # out and putting it back leaves the file as it was.
    awk -v begin="$begin" -v end="$end" '
        index($0, begin) == 1 { inside = 1 }
        inside { if (index($0, end) == 1) { inside = 0; blank = 1 } next }
        blank && $0 ~ /^[[:space:]]*$/ { blank = 0; next }
        { blank = 0; print }
    ' "$BINDINGS" > "$BINDINGS.jobsdone"
    printf '%s\n' "$(cat "$BINDINGS.jobsdone")" > "$BINDINGS"
    rm -f "$BINDINGS.jobsdone"
}

if [ -e "$HOME/.local/bin/jobsdone" ]; then
    if command -v cargo >/dev/null && cargo install --list --root "$HOME/.local" 2>/dev/null | grep -q '^jobsdone '; then
        cargo uninstall jobsdone --root "$HOME/.local" --quiet
    else
        rm -f "$HOME/.local/bin/jobsdone"
    fi
    say "removed the binary"
fi

rm -f "$DESKTOP_FILE" "$ICON_FILE"
command -v update-desktop-database >/dev/null && update-desktop-database "$(dirname "$DESKTOP_FILE")" 2>/dev/null || true
say "removed the launcher entry"

if [ -f "$BINDINGS" ]; then
    removed=no
    for ((i = 0; i < ${#BLOCKS[@]}; i += 2)); do
        if remove_block "${BLOCKS[i]}" "${BLOCKS[i + 1]}"; then
            removed=yes
        fi
    done
    if [ "$removed" = yes ]; then
        say "removed the jobsdone blocks from $BINDINGS"
        if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
            hyprctl reload >/dev/null && say "Hyprland reloaded"
        fi
    fi
fi

say "kept the data in $DATA_HOME/jobsdone and the log in $STATE_HOME/jobsdone"

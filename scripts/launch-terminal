#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
APP_ID="org.omarchy.jobsdone"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JOBSDONE="$SCRIPT_DIR/jobsdone"

terminal_id="${JOBSDONE_TERMINAL:-}"
if [ -z "$terminal_id" ] && command -v xdg-terminal-exec >/dev/null; then
    terminal_id="$(xdg-terminal-exec --print-id 2>/dev/null || true)"
fi
if [ -z "$terminal_id" ] && [ -n "${TERMINAL:-}" ]; then
    terminal_id="${TERMINAL##*/}"
fi
if [ -z "$terminal_id" ]; then
    for candidate in foot kitty alacritty ghostty; do
        if [ "$candidate" = foot ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
            continue
        fi
        if command -v "$candidate" >/dev/null; then
            terminal_id="$candidate"
            break
        fi
    done
fi
terminal_id="${terminal_id,,}"
case "$terminal_id" in
    foot | foot.desktop)
        exec foot --config "$CONFIG_HOME/jobsdone/foot.ini" --app-id="$APP_ID" -e "$JOBSDONE"
        ;;
    kitty | kitty.desktop)
        exec kitty --config "$CONFIG_HOME/jobsdone/kitty.conf" --class "$APP_ID" "$JOBSDONE"
        ;;
    alacritty | alacritty.desktop)
        if alacritty --version | grep -qE ' 0\.(1[0-3]|[0-9])\.'; then
            config="$CONFIG_HOME/jobsdone/alacritty-0.13.toml"
        else
            config="$CONFIG_HOME/jobsdone/alacritty.toml"
        fi
        exec alacritty --config-file "$config" --class "$APP_ID" -e "$JOBSDONE"
        ;;
    ghostty | ghostty.desktop | com.mitchellh.ghostty.desktop)
        exec ghostty --config-file="$CONFIG_HOME/jobsdone/ghostty.conf" --class="$APP_ID" -e "$JOBSDONE"
        ;;
    *)
        if command -v xdg-terminal-exec >/dev/null; then
            exec xdg-terminal-exec --app-id="$APP_ID" -e "$JOBSDONE"
        fi
        exec "${TERMINAL:-xterm}" -e "$JOBSDONE"
        ;;
esac
